# scrapers/.env.example
CRM_API_URL=https://your-crm.vercel.app/api/listings
SCRAPER_API_KEY=crm_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx   # gerada em Dashboard → Definições → API Keys
MAXWORK_EMAIL=elsiomota@remax.pt
MAXWORK_PASSWORD=a-tua-password
HEADLESS=true
# Obrigatório para maxwork_to_csv.py (pesquisa por agência) — nomes de
# agências (separados por vírgula) a pesquisar em /listing/search. Inclui
# a tua própria agência aqui também, se quiseres os teus imóveis (não só
# os de outras agências). Não é usado por maxwork_to_csv_bulk.py (pesquisa
# global, sem filtro).
MAXWORK_AGENCIES=4 You

# Opcional — nº de abas em paralelo no maxwork_details_to_csv.py (omissão
# 4). Cada ficha de imóvel é independente e só de leitura, por isso corre
# bem em paralelo; baixa para 1 se quiseres voltar ao comportamento
# sequencial antigo.
MAXWORK_DETAILS_CONCURRENCY=4
