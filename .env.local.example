# Telegram Bot (opcional — para enviar áudios do Plaud via Telegram)
# 1. Cria um bot com @BotFather e copia o token
TELEGRAM_BOT_TOKEN=
# 2. Segredo aleatório para verificar webhooks (gera com: openssl rand -hex 32)
TELEGRAM_WEBHOOK_SECRET=
# 3. Chat IDs autorizados a usar o bot (separados por vírgula). Obtém o teu ID enviando /start
TELEGRAM_ALLOWED_CHAT_IDS=
# 4. UUID da equipa no Supabase (copia de Settings → equipa)
TELEGRAM_DEFAULT_TEAM_ID=
# 5. UUID do utilizador a quem as leads ficam atribuídas
TELEGRAM_DEFAULT_USER_ID=
