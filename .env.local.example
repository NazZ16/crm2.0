NEXT_PUBLIC_SITE_URL=https://teu-projeto.vercel.app

NEXT_PUBLIC_SUPABASE_URL=https://....supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ey...
SUPABASE_SERVICE_ROLE_KEY=ey...

ANTHROPIC_API_KEY=sk-...
OPENAI_API_KEY=sk-...

RESEND_API_KEY=re_...

META_ACCESS_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
TIKTOK_ACCESS_TOKEN=

# Telegram Bot (opcional — para enviar áudios do Plaud via Telegram)
# 1. Cria um bot com @BotFather e copia o token
TELEGRAM_BOT_TOKEN=
# 2. Segredo aleatório para verificar webhooks (gera com: openssl rand -hex 32)
TELEGRAM_WEBHOOK_SECRET=
# 3. Chat IDs autorizados a usar o bot (separados por vírgula). Obtém o teu ID enviando /start
TELEGRAM_ALLOWED_CHAT_IDS=
# 4. UUID da equipa no Supabase (copia de Settings → equipa)
TELEGRAM_DEFAULT_TEAM_ID=
# 5. UUID do utilizador a quem as leads ficam atribuídas
TELEGRAM_DEFAULT_USER_ID=

# WhatsApp — leitura apenas, atualiza o CRM quando chega mensagem.
# WHATSAPP_DEFAULT_TEAM_ID / WHATSAPP_DEFAULT_USER_ID são usados por AMBOS os caminhos abaixo
# (podem ser os mesmos valores do Telegram acima).
WHATSAPP_DEFAULT_TEAM_ID=
WHATSAPP_DEFAULT_USER_ID=

# -- Caminho A: Cloud API oficial da Meta (parado por agora — bloqueado em verificação de
#    negócio da Meta, ver whatsapp-worker/ para o caminho ativo). Fica configurado para o caso
#    de a verificação se resolver no futuro.
# 1. App em developers.facebook.com com o produto "WhatsApp" + WABA ligada ao número profissional
# 2. Secret da App (Settings → Basic) — usado para validar a assinatura dos webhooks
WHATSAPP_APP_SECRET=
# 3. Token à tua escolha (gera com: openssl rand -hex 32) — usado só no handshake de verificação do webhook
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# -- Caminho B: worker Baileys (não-oficial, ativo) — ver whatsapp-worker/README.md
# Segredo partilhado entre o worker (Railway) e este endpoint (gera com: openssl rand -hex 32).
# O mesmo valor vai também para CRM_INGEST_SECRET nas env vars do worker na Railway.
WHATSAPP_BAILEYS_INGEST_SECRET=
